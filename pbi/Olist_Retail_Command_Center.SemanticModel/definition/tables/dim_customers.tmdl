table dim_customers
	lineageTag: 10000000-0000-0000-0000-000000000002

	column customer_key
		dataType: int64
		isKey
		formatString: 0
		sourceColumn: customer_key

	column customer_id
		dataType: string
		sourceColumn: customer_id

	column customer_unique_id
		dataType: string
		sourceColumn: customer_unique_id

	column customer_city
		dataType: string
		sourceColumn: customer_city

	column customer_state
		dataType: string
		sourceColumn: customer_state

	column customer_region
		dataType: string
		sourceColumn: customer_region

	partition dim_customers = m
		mode: import
		source = 
			let
				Source = Csv.Document(File.Contents("data/olist_customers_dataset.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
				#"Promoted Headers"
